{
  "name": "discord-bot-player",
  "version": "1.5.6",
  "description": "Discord Bot service to play songs",
  "main": "src/main/server.ts",
  "repository": "git@github.com:RaFaTEOLI/discord-bot-player.git",
  "author": "RaFaTEOLI",
  "license": "MIT",
  "scripts": {
    "prepare": "husky install",
    "start": "tsx src/main/server.ts",
    "dev": "tsx watch src/main/server.ts",
    "build": "rimraf dist && tsc -p tsconfig-build.json",
    "debug": "tsx watch --inspect=0.0.0.0:9222 --nolazy src/main/server.ts",
    "test": "vitest --run --passWithNoTests --silent",
    "test:staged": "yarn test related",
    "test:ci": "yarn test --coverage",
    "validate:youtube-cookie": "tsx scripts/validate-youtube-cookie.ts"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.0",
    "@snazzah/davey": "^0.1.7",
    "amqplib": "^0.10.3",
    "axios": "^1.7.9",
    "bgutils-js": "4.0.3",
    "discord.js": "^14.24.0",
    "dotenv": "^16.0.3",
    "isomorphic-unfetch": "^3.1.0",
    "jsdom": "^26",
    "module-alias": "^2.2.2",
    "tsx": "^4.7.0",
    "youtubei.js": "18.3.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^7.6.0",
    "@types/amqplib": "^0.10.1",
    "@types/jsdom": "^21",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^5.39.0",
    "@vitest/coverage-istanbul": "^2.0.4",
    "eslint": "^8.24.0",
    "eslint-config-standard-with-typescript": "^23.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-n": "^15.0.0",
    "eslint-plugin-promise": "^6.0.0",
    "git-commit-msg-linter": "^4.2.1",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3",
    "rimraf": "^3.0.2",
    "typescript": "~5.9.3",
    "vitest": "^2.0.4"
  },
  "engines": {
    "node": ">=22.12"
  },
  "_moduleAliases": {
    "@": "dist"
  }
}
