BOT_NAME=
BOT_DESCRIPTION=
BOT_ACTIVITY=
BOT_PREFIX=!
BOT_TOKEN=
BOT_MUSIC_CHANNEL=
BOT_WELCOME_CHANNEL=
BOT_URL=
BOT_API_URL=
BOT_API_TOKEN=
BOT_API_QUEUE_USERNAME=
BOT_API_QUEUE_PASSWORD=
BOT_API_QUEUE_PORT=
BOT_API_QUEUE_ADRESS=
BOT_USE_API_QUEUE=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional: youtube.com "Cookie" request header from a logged-in browser session ("name=value; name2=value2").
# Helps when YouTube serves bot checks. Check it with `yarn validate:youtube-cookie`.
YOUTUBE_COOKIE=
# PO tokens are generated automatically (needed for official music videos); set to false to disable.
YOUTUBE_PO_TOKEN_GENERATION=
# Optional static PO token + matching visitor data (turns generation off).
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=
# Optional comma list of InnerTube clients tried in order for streaming (e.g. MWEB,YTMUSIC).
YOUTUBE_CLIENTS=